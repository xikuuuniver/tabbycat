{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pipenv install --deploy --ignore-pipfile && npm ci && npm run build && python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && gunicorn tabbycat.wsgi --bind 0.0.0.0:8000 --workers 4 --timeout 120",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  }
}

